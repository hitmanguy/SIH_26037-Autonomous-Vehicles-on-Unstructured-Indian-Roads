<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-29T00:00:00" description="ASAM OpenSCENARIO Standard Example: Simple Lane Change" author="ASAM e.V."/>
  <ParameterDeclarations>
    <ParameterDeclaration name="Ego_Speed" parameterType="double" value="13.88"/> <!-- 50 km/h -->
  </ParameterDeclarations>
  <RoadNetwork>
    <LogicFile filepath="../../maps_xodr/Indian_Urban_Arterial.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="Sedan_Ego" vehicleCategory="car">
        <Dimensions width="1.80" length="4.50" height="1.50"/>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="LeadingVehicle">
      <Vehicle name="Sedan_Lead" vehicleCategory="car">
        <Dimensions width="1.80" length="4.50" height="1.50"/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><WorldPosition x="20.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Ego_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="LeadingVehicle">
          <PrivateAction><TeleportAction><Position><WorldPosition x="70.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="8.33"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="LaneChangeStory">
      <Act name="LaneChangeAct">
        <ManeuverGroup maximumExecutionCount="1" name="MG_Ego">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
          <Maneuver name="Maneuver_LaneChange">
            <Event name="Event_LaneChange" priority="overwrite">
              <Action name="Action_LaneChange">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="2.5" dynamicsDimension="time"/>
                      <LaneChangeTarget><RelativeTargetLane entityRef="Ego" value="1"/></LaneChangeTarget>
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="DistanceCondition" delay="0" conditionEdge="rising">
                    <EntityCondition>
                      <DistanceCondition value="25.0" freespace="false" rule="lessThan">
                        <EntityRef entityRef="LeadingVehicle"/>
                      </DistanceCondition>
                    </EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger/>
  </Storyboard>
</OpenSCENARIO>
