<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-30T00:00:00" description="THE GAUNTLET - SEQUENTIAL MULTI-HAZARD STRESS TEST" author="SIH26 Autonomous Driving Team"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="Ego_Speed" parameterType="double" value="6.94"/>
    <ParameterDeclaration name="Rickshaw_Speed" parameterType="double" value="2.78"/>
    <ParameterDeclaration name="Jaywalker_Speed" parameterType="double" value="1.5"/>
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog><Directory path="../catalogs/vehicles"/></VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../../maps_xodr/Indian_Urban_Arterial.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoVehicle" vehicleCategory="car">
        <Dimensions width="1.80" length="4.50" height="1.48"/>
        <Performance maxSpeed="55.5" maxAcceleration="6.0" maxDeceleration="9.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.7"/><Dimension width="1.80" length="4.50" height="1.48"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.55" positionX="2.8" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.55" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="SlowRickshaw">
      <Vehicle name="BajajAutoRickshaw" vehicleCategory="car">
        <Dimensions width="1.30" length="2.65" height="1.70"/>
        <Performance maxSpeed="15.0" maxAcceleration="3.0" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.0" y="0.0" z="0.85"/><Dimension width="1.30" length="2.65" height="1.70"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.6" wheelDiameter="0.4" trackWidth="1.1" positionX="1.8" positionZ="0.2"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.4" trackWidth="1.1" positionX="0.0" positionZ="0.2"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="ConstructionBarrier1">
      <MiscObject name="JerseyBarrier1" miscObjectCategory="barrier" mass="100.0">
        <Dimensions width="0.80" length="5.00" height="0.80"/>
        <BoundingBox><Center x="2.5" y="0.0" z="0.4"/><Dimension width="0.80" length="5.00" height="0.80"/></BoundingBox>
      </MiscObject>
    </ScenarioObject>
    <ScenarioObject name="ConstructionBarrier2">
      <MiscObject name="JerseyBarrier2" miscObjectCategory="barrier" mass="100.0">
        <Dimensions width="0.80" length="3.00" height="0.80"/>
        <BoundingBox><Center x="1.5" y="0.0" z="0.4"/><Dimension width="0.80" length="3.00" height="0.80"/></BoundingBox>
      </MiscObject>
    </ScenarioObject>
    <ScenarioObject name="ConstructionWorker">
      <Pedestrian name="WorkerPedestrian" pedestrianCategory="pedestrian" mass="70.0">
        <Dimensions width="0.45" length="0.28" height="1.75"/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.875"/><Dimension width="0.45" length="0.28" height="1.75"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="ParkedTruck">
      <Vehicle name="TataHeavyTruck" vehicleCategory="truck">
        <Dimensions width="2.45" length="7.80" height="3.20"/>
        <Performance maxSpeed="25.0" maxAcceleration="2.0" maxDeceleration="5.0"/>
        <BoundingBox><Center x="2.5" y="0.0" z="1.6"/><Dimension width="2.45" length="7.80" height="3.20"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.4" wheelDiameter="1.0" trackWidth="2.0" positionX="5.2" positionZ="0.5"/>
               <RearAxle maxSteering="0.0" wheelDiameter="1.0" trackWidth="2.0" positionX="0.0" positionZ="0.5"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Jaywalker">
      <Pedestrian name="JaywalkerPedestrian" pedestrianCategory="pedestrian" mass="70.0">
        <Dimensions width="0.45" length="0.28" height="1.75"/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.875"/><Dimension width="0.45" length="0.28" height="1.75"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="OncomingBike">
      <Vehicle name="RoyalEnfieldBike" vehicleCategory="motorbike">
        <Dimensions width="0.75" length="2.10" height="1.20"/>
        <Performance maxSpeed="30.0" maxAcceleration="4.0" maxDeceleration="7.0"/>
        <BoundingBox><Center x="0.7" y="0.0" z="0.6"/><Dimension width="0.75" length="2.10" height="1.20"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="0.1" positionX="1.4" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="0.1" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><WorldPosition x="15.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Ego_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="SlowRickshaw">
          <PrivateAction><TeleportAction><Position><WorldPosition x="75.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Rickshaw_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ConstructionBarrier1">
          <PrivateAction><TeleportAction><Position><WorldPosition x="145.0" y="-1.75" z="0.4" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ConstructionBarrier2">
          <PrivateAction><TeleportAction><Position><WorldPosition x="158.0" y="-1.75" z="0.4" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ConstructionWorker">
          <PrivateAction><TeleportAction><Position><WorldPosition x="150.0" y="-0.80" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.4"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ParkedTruck">
          <PrivateAction><TeleportAction><Position><WorldPosition x="225.0" y="-5.25" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="Jaywalker">
          <PrivateAction><TeleportAction><Position><WorldPosition x="230.0" y="-7.0" z="0.0" h="1.5707"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="OncomingBike">
          <PrivateAction><TeleportAction><Position><WorldPosition x="280.0" y="1.75" z="0.0" h="3.14159"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="11.11"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="GauntletStory">
      <Act name="GauntletAct">
        <ManeuverGroup maximumExecutionCount="1" name="MG_Jaywalker">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Jaywalker"/>
          </Actors>
          <Maneuver name="Maneuver_JaywalkCross">
            <Event name="JaywalkCrossEvent" priority="overwrite">
              <Action name="JaywalkAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="0.5" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$Jaywalker_Speed"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="JaywalkDistanceTrigger" delay="0" conditionEdge="rising">
                    <EntityCondition>
                      <DistanceCondition value="30.0" freespace="false" rule="lessThan">
                        <EntityRef entityRef="Ego"/>
                      </DistanceCondition>
                    </EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger/>
  </Storyboard>
</OpenSCENARIO>
