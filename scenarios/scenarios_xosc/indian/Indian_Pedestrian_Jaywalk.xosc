<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-30T00:00:00" description="Mid-block Pedestrians Jaywalking Behind Parked Bus - Multi-Pedestrian with Running Child" author="SIH26 Autonomous Driving Team"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="Ego_Speed" parameterType="double" value="6.94"/>  <!-- 25 km/h steady cruise -->
    <ParameterDeclaration name="Adult_Speed" parameterType="double" value="1.5"/> <!-- Adult walking speed -->
    <ParameterDeclaration name="Child_Speed" parameterType="double" value="2.5"/> <!-- Child running speed -->
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog><Directory path="../catalogs/vehicles"/></VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../../maps_xodr/Indian_Urban_Arterial.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoCar" vehicleCategory="car">
        <Dimensions width="1.80" length="4.50" height="1.48"/>
        <Performance maxSpeed="55.5" maxAcceleration="6.0" maxDeceleration="9.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.7"/><Dimension width="1.80" length="4.50" height="1.48"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.55" positionX="2.8" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.55" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="ParkedBus">
      <Vehicle name="BMTC_Bus" vehicleCategory="bus">
        <Dimensions width="2.60" length="11.00" height="3.20"/>
        <Performance maxSpeed="25.0" maxAcceleration="2.0" maxDeceleration="5.0"/>
        <BoundingBox><Center x="3.5" y="0.0" z="1.6"/><Dimension width="2.60" length="11.00" height="3.20"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.4" wheelDiameter="1.0" trackWidth="2.1" positionX="7.0" positionZ="0.5"/>
               <RearAxle maxSteering="0.0" wheelDiameter="1.0" trackWidth="2.1" positionX="0.0" positionZ="0.5"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Pedestrian">
      <Pedestrian name="Pedestrian_Jaywalker" pedestrianCategory="pedestrian" mass="70.0">
        <Dimensions width="0.45" length="0.28" height="1.75"/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.875"/><Dimension width="0.45" length="0.28" height="1.75"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="RunningChild">
      <Pedestrian name="Child_Runner" pedestrianCategory="pedestrian" mass="25.0">
        <Dimensions width="0.35" length="0.25" height="1.15"/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.575"/><Dimension width="0.35" length="0.25" height="1.15"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="OncomingScooter">
      <Vehicle name="HondaActiva" vehicleCategory="motorbike">
        <Dimensions width="0.70" length="1.85" height="1.15"/>
        <Performance maxSpeed="25.0" maxAcceleration="3.5" maxDeceleration="6.0"/>
        <BoundingBox><Center x="0.6" y="0.0" z="0.575"/><Dimension width="0.70" length="1.85" height="1.15"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.5" trackWidth="0.1" positionX="1.2" positionZ="0.25"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.5" trackWidth="0.1" positionX="0.0" positionZ="0.25"/></Axles>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><WorldPosition x="20.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Ego_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ParkedBus">
          <PrivateAction><TeleportAction><Position><WorldPosition x="90.0" y="-5.25" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="Pedestrian">
          <PrivateAction><TeleportAction><Position><WorldPosition x="97.0" y="-7.0" z="0.0" h="1.5707"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Adult_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="RunningChild">
          <PrivateAction><TeleportAction><Position><WorldPosition x="93.0" y="-7.0" z="0.0" h="1.5707"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Child_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="OncomingScooter">
          <PrivateAction><TeleportAction><Position><WorldPosition x="200.0" y="1.75" z="0.0" h="3.14159"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="8.33"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="JaywalkStory">
      <Act name="JaywalkAct">
        <ManeuverGroup maximumExecutionCount="1" name="MG_Ped">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Pedestrian"/></Actors>
          <Maneuver name="Maneuver_Cross">
            <Event name="CrossEvent" priority="overwrite">
              <Action name="CrossWalk">
                <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="0.5" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Adult_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="TriggerDist" delay="0" conditionEdge="rising">
                    <EntityCondition><DistanceCondition value="35.0" freespace="false" rule="lessThan"><EntityRef entityRef="Ego"/></DistanceCondition></EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="MG_Child">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="RunningChild"/></Actors>
          <Maneuver name="Maneuver_ChildRun">
            <Event name="ChildRunEvent" priority="overwrite">
              <Action name="ChildSprint">
                <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="0.3" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Child_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ChildTrigger" delay="0" conditionEdge="rising">
                    <EntityCondition><DistanceCondition value="28.0" freespace="false" rule="lessThan"><EntityRef entityRef="Ego"/></DistanceCondition></EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger/>
  </Storyboard>
</OpenSCENARIO>
