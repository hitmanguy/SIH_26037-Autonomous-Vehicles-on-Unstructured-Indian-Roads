<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-30T00:00:00" description="Indian Road Pothole-Forced Detour around Road Hazard Barrier" author="SIH26 Autonomous Driving Team"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="Ego_Speed" parameterType="double" value="6.94"/>      <!-- 25 km/h steady cruise -->
    <ParameterDeclaration name="Pedestrian_Speed" parameterType="double" value="1.2"/><!-- 4.3 km/h -->
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog><Directory path="../catalogs/vehicles"/></VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../../maps_xodr/Indian_Urban_Arterial.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoVehicle" vehicleCategory="car">
        <Dimensions width="1.82" length="4.45" height="1.48"/>
        <Performance maxSpeed="55.5" maxAcceleration="6.0" maxDeceleration="9.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.7"/><Dimension width="1.82" length="4.45" height="1.48"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.55" positionX="2.8" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.55" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="ShoulderPedestrian">
      <Pedestrian name="Pedestrian_Walking" mass="70.0" pedestrianCategory="pedestrian">
        <Dimensions width="0.45" length="0.25" height="1.75"/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.875"/><Dimension width="0.45" length="0.25" height="1.75"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="RoadWorkBarrier">
      <MiscObject name="RoadBarrier" miscObjectCategory="barrier">
        <Dimensions width="0.80" length="5.00" height="0.80"/>
        <BoundingBox><Center x="2.5" y="0.0" z="0.4"/><Dimension width="0.80" length="5.00" height="0.80"/></BoundingBox>
      </MiscObject>
    </ScenarioObject>
    <ScenarioObject name="WarningCone">
      <MiscObject name="TrafficCone" miscObjectCategory="barrier" mass="5.0">
        <Dimensions width="0.30" length="0.30" height="0.70"/>
        <BoundingBox><Center x="0.15" y="0.0" z="0.35"/><Dimension width="0.30" length="0.30" height="0.70"/></BoundingBox>
      </MiscObject>
    </ScenarioObject>
    <ScenarioObject name="OncomingCar">
      <Vehicle name="MarutiSwift_Oncoming" vehicleCategory="car">
        <Dimensions width="1.75" length="3.90" height="1.50"/>
        <Performance maxSpeed="45.0" maxAcceleration="3.5" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.2" y="0.0" z="0.75"/><Dimension width="1.75" length="3.90" height="1.50"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.45" positionX="2.4" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.45" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><WorldPosition x="25.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Ego_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ShoulderPedestrian">
          <PrivateAction><TeleportAction><Position><WorldPosition x="85.0" y="-6.50" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Pedestrian_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="RoadWorkBarrier">
          <PrivateAction><TeleportAction><Position><WorldPosition x="85.0" y="-1.75" z="0.4" h="0.0"/></Position></TeleportAction></PrivateAction>
        </Private>
        <Private entityRef="WarningCone">
          <PrivateAction><TeleportAction><Position><WorldPosition x="80.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
        </Private>
        <Private entityRef="OncomingCar">
          <PrivateAction><TeleportAction><Position><WorldPosition x="220.0" y="1.75" z="0.0" h="3.14159"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="8.33"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <StopTrigger/>
  </Storyboard>
</OpenSCENARIO>
