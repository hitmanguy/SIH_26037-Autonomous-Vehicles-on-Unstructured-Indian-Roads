        <Private entityRef="Guardian">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="118.0" y="2.0" z="0.0" h="4.7124"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
