    </ScenarioObject>
    <ScenarioObject name="SchoolBus">
      <Vehicle name="YellowSchoolBus" vehicleCategory="truck">
        <Dimensions width="2.40" length="9.50" height="3.00"/>
        <Performance maxSpeed="25.0" maxAcceleration="2.0" maxDeceleration="5.0"/>
        <BoundingBox>
