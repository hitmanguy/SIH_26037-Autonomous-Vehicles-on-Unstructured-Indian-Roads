                  <AbsoluteTargetSpeed value="0.0"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="SchoolZoneRushStory">
      <Act name="ChildrenCrossingAct">
        <ManeuverGroup maximumExecutionCount="1" name="MG_RunningChild">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="RunningChild"/>
          </Actors>
          <Maneuver name="Maneuver_RunningChildCross">
            <Event name="Event_RunningChildCross" priority="overwrite">
              <Action name="Action_RunningChildSpeed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="0.2" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$RunningChild_Speed"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="RunningChildDistanceTrigger" delay="0" conditionEdge="rising">
                    <EntityCondition>
                      <DistanceCondition value="45.0" freespace="false" rule="lessThan">
                        <EntityRef entityRef="Ego"/>
                      </DistanceCondition>
                    </EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="MG_WalkingChild">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="WalkingChild"/>
          </Actors>
          <Maneuver name="Maneuver_WalkingChildCross">
            <Event name="Event_WalkingChildCross" priority="overwrite">
              <Action name="Action_WalkingChildSpeed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="0.3" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$WalkingChild_Speed"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="WalkingChildDistanceTrigger" delay="0" conditionEdge="rising">
                    <EntityCondition>
                      <DistanceCondition value="35.0" freespace="false" rule="lessThan">
                        <EntityRef entityRef="Ego"/>
                      </DistanceCondition>
                    </EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="MG_SprintingChild">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="SprintingChild"/>
          </Actors>
          <Maneuver name="Maneuver_SprintingChildCross">
            <Event name="Event_SprintingChildCross" priority="overwrite">
              <Action name="Action_SprintingChildSpeed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="0.1" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$SprintingChild_Speed"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="SprintingChildDistanceTrigger" delay="0" conditionEdge="rising">
                    <EntityCondition>
                      <DistanceCondition value="25.0" freespace="false" rule="lessThan">
                        <EntityRef entityRef="Ego"/>
                      </DistanceCondition>
                    </EntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger/>
  </Storyboard>
</OpenSCENARIO>
