    <ScenarioObject name="Guardian">
      <Pedestrian name="AdultGuardian" pedestrianCategory="pedestrian" mass="70.0">
        <Dimensions width="0.45" length="0.28" height="1.75"/>
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.875"/>
          <Dimension width="0.45" length="0.28" height="1.75"/>
        </BoundingBox>
      </Pedestrian>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="25.0" y="-1.75" z="0.0" h="0.0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$Ego_Speed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="SchoolBus">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="120.0" y="-5.25" z="0.0" h="0.0"/>
