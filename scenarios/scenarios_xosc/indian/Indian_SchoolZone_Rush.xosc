<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-30T00:00:00" description="School Zone - Multiple Children Darting Across Road with Stopped School Bus and Waiting Guardian" author="SIH26 Autonomous Driving Team"/>
  <ParameterDeclarations>
