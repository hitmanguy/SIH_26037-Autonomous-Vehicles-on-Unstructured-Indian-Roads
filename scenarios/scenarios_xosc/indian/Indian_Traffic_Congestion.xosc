<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-30T00:00:00" description="Indian Dense Traffic Congestion with Multi-Vehicle Queue and Filtering Bicycle" author="SIH26 Autonomous Driving Team"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="Ego_Speed" parameterType="double" value="8.33"/>  <!-- 30 km/h -->
    <ParameterDeclaration name="Queue_Speed" parameterType="double" value="4.0"/> <!-- Crawl speed 14.4 km/h -->
    <ParameterDeclaration name="Bicycle_Speed" parameterType="double" value="5.0"/><!-- 18 km/h -->
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog><Directory path="../catalogs/vehicles"/></VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../../maps_xodr/Indian_Urban_Arterial.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoVehicle" vehicleCategory="car">
        <Dimensions width="1.82" length="4.45" height="1.48"/>
        <Performance maxSpeed="55.5" maxAcceleration="6.0" maxDeceleration="9.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.7"/><Dimension width="1.82" length="4.45" height="1.48"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.55" positionX="2.8" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.55" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="SlowCar1">
      <Vehicle name="Hatchback_Silver" vehicleCategory="car">
        <Dimensions width="1.70" length="3.95" height="1.50"/>
        <Performance maxSpeed="40.0" maxAcceleration="3.0" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.2" y="0.0" z="0.75"/><Dimension width="1.70" length="3.95" height="1.50"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.45" positionX="2.4" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.45" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="ParkedCar">
      <Vehicle name="Sedan_Red" vehicleCategory="car">
        <Dimensions width="1.78" length="4.50" height="1.45"/>
        <Performance maxSpeed="45.0" maxAcceleration="3.5" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.3" y="0.0" z="0.7"/><Dimension width="1.78" length="4.50" height="1.45"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.50" positionX="2.6" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.50" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="LeadTruck">
      <Vehicle name="BoxTruck_Brown" vehicleCategory="truck">
        <Dimensions width="2.45" length="7.80" height="3.20"/>
        <Performance maxSpeed="25.0" maxAcceleration="2.0" maxDeceleration="5.0"/>
        <BoundingBox><Center x="2.5" y="0.0" z="1.6"/><Dimension width="2.45" length="7.80" height="3.20"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.4" wheelDiameter="1.0" trackWidth="2.0" positionX="5.2" positionZ="0.5"/>
               <RearAxle maxSteering="0.0" wheelDiameter="1.0" trackWidth="2.0" positionX="0.0" positionZ="0.5"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="CreepTruck">
      <Vehicle name="Truck_Green" vehicleCategory="truck">
        <Dimensions width="2.30" length="6.80" height="2.90"/>
        <Performance maxSpeed="25.0" maxAcceleration="2.0" maxDeceleration="5.0"/>
        <BoundingBox><Center x="2.2" y="0.0" z="1.45"/><Dimension width="2.30" length="6.80" height="2.90"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.4" wheelDiameter="0.9" trackWidth="1.9" positionX="4.5" positionZ="0.45"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.9" trackWidth="1.9" positionX="0.0" positionZ="0.45"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="AheadCar">
      <Vehicle name="Sedan_White" vehicleCategory="car">
        <Dimensions width="1.80" length="4.60" height="1.46"/>
        <Performance maxSpeed="45.0" maxAcceleration="3.5" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.7"/><Dimension width="1.80" length="4.60" height="1.46"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.52" positionX="2.7" positionZ="0.3"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.52" positionX="0.0" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Bicycle">
      <Vehicle name="FilteringBicycle" vehicleCategory="bicycle">
        <Dimensions width="0.65" length="1.80" height="1.10"/>
        <Performance maxSpeed="10.0" maxAcceleration="1.5" maxDeceleration="4.0"/>
        <BoundingBox><Center x="0.6" y="0.0" z="0.55"/><Dimension width="0.65" length="1.80" height="1.10"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.6" wheelDiameter="0.65" trackWidth="0.1" positionX="1.2" positionZ="0.32"/>
               <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="0.1" positionX="0.0" positionZ="0.32"/></Axles>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><WorldPosition x="20.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="$Ego_Speed"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="SlowCar1">
          <PrivateAction><TeleportAction><Position><WorldPosition x="50.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="3.5"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="ParkedCar">
          <PrivateAction><TeleportAction><Position><WorldPosition x="65.0" y="-5.50" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="LeadTruck">
          <PrivateAction><TeleportAction><Position><WorldPosition x="130.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="3.5"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="CreepTruck">
          <PrivateAction><TeleportAction><Position><WorldPosition x="85.0" y="-5.10" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="2.8"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="AheadCar">
          <PrivateAction><TeleportAction><Position><WorldPosition x="85.0" y="-1.75" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="3.5"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="Bicycle">
          <PrivateAction><TeleportAction><Position><WorldPosition x="35.0" y="-3.50" z="0.0" h="0.0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/><SpeedActionTarget><AbsoluteTargetSpeed value="4.2"/></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="IndianCongestionStory">
      <Act name="CongestionAct">
        <ManeuverGroup maximumExecutionCount="1" name="ManeuverGroup_Queue">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Bicycle"/></Actors>
          <Maneuver name="Maneuver_Filter">
            <Event name="FilterEvent" priority="overwrite">
              <Action name="FilterLaneWeave">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="2.0" dynamicsDimension="time"/>
                      <LaneChangeTarget><RelativeTargetLane entityRef="Ego" value="0"/></LaneChangeTarget>
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="TimeCondition" delay="0" conditionEdge="rising">
                    <ByValueCondition><SimulationTimeCondition value="2.0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger/>
  </Storyboard>
</OpenSCENARIO>
