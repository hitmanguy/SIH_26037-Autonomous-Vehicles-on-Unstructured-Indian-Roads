<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2026-09-30T00:00:00" description="Wrong-Way Vehicle Head-On Encounter with Parked Obstruction" author="SIH26 Autonomous Driving Team"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="Ego_Speed" parameterType="double" value="6.94"/>       <!-- 25 km/h -->
    <ParameterDeclaration name="WrongWay_Speed" parameterType="double" value="8.33"/>  <!-- 30 km/h -->
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog><Directory path="../catalogs/vehicles"/></VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
