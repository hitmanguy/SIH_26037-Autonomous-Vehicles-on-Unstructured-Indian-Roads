        <Performance maxSpeed="35.0" maxAcceleration="3.0" maxDeceleration="6.0"/>
        <BoundingBox><Center x="2.0" y="0.0" z="1.1"/><Dimension width="1.90" length="5.80" height="2.20"/></BoundingBox>
